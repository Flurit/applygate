{
  "servers": [
    {
      "name": "awslabs aws-api-mcp-server",
      "source": "github.com/awslabs/mcp@c6951b9 src/aws-api-mcp-server/awslabs/aws_api_mcp_server/server.py:249-261 (cli_command: one 'aws ...' string or a list of up to 20), core/parser/lexer.py:41-51 (shlex split, must start with aws)",
      "tools": [
        {"names": ["call_aws"], "requires": ["cli_command"], "shell": "cli_command",
         "note": "the server runs each aws command itself, without a shell"}
      ]
    },
    {
      "name": "awslabs terraform-mcp-server",
      "source": "github.com/awslabs/mcp@780e3f1 (last tree before removal in 092e7ca) src/terraform-mcp-server/awslabs/terraform_mcp_server/impl/tools/execute_terraform_command.py:152-163 and execute_terragrunt_command.py:212-260: apply, destroy and run-all always get -auto-approve; no saved planfile",
      "tools": [
        {"names": ["ExecuteTerraformCommand"], "requires": ["command", "working_directory"], "dir": "working_directory",
         "cases": [
           {"when": {"command": ["apply", "destroy"]}, "command": "terraform {command} -auto-approve"},
           {"when": {"command": ["init", "plan", "validate"]}, "command": "terraform {command}"}
         ]},
        {"names": ["ExecuteTerragruntCommand"], "requires": ["command", "working_directory"], "dir": "working_directory",
         "cases": [
           {"when": {"command": ["run-all"]}, "command": "terragrunt run-all apply -auto-approve"},
           {"when": {"command": ["apply", "destroy"]}, "command": "terragrunt {command} -auto-approve"},
           {"when": {"command": ["init", "plan", "validate", "output"]}, "command": "terragrunt {command}"}
         ]}
      ]
    },
    {
