    {
      "name": "hashicorp terraform-mcp-server (HCP Terraform / Terraform Enterprise)",
      "source": "github.com/hashicorp/terraform-mcp-server@062700d pkg/tools/tfe/create_run.go:136-212 (run_type is_destroy sets IsDestroy, auto_approve sets AutoApply; plan_and_apply waits for confirmation), action_run.go:63-72, delete_workspace_safely.go:55, force_unlock_workspace.go:64",
      "tools": [
        {"names": ["create_run"], "requires": ["terraform_org_name", "workspace_name"],
         "note": "a run on HCP Terraform, judged as the terraform command on that workspace",
         "cases": [
           {"when": {"run_type": ["is_destroy"]}, "command": "TF_WORKSPACE={workspace_name} terraform destroy"},
           {"when": {"run_type": ["auto_approve", "allow_empty_apply"]}, "command": "TF_WORKSPACE={workspace_name} terraform apply -auto-approve"},
           {"when": {"run_type": ["refresh_state"]}, "command": "TF_WORKSPACE={workspace_name} terraform apply -refresh-only"},
           {"when": {"run_type": ["plan_and_apply", "plan_only", ""]}, "command": "TF_WORKSPACE={workspace_name} terraform plan"},
           {"command": "?creates a run of type {run_type} on workspace {workspace_name}"}
         ]},
        {"names": ["action_run"], "requires": ["run_action", "run_id"],
         "cases": [
           {"when": {"run_action": ["apply"]}, "command": "?applies HCP Terraform run {run_id}, whose plan applygate cannot read"},
           {"when": {"run_action": ["discard", "cancel"]}, "command": "true"}
         ]},
        {"names": ["delete_workspace_safely"], "requires": ["workspace_id"],
         "cases": [{"command": "terraform workspace delete {workspace_id}"}]},
        {"names": ["force_unlock_workspace"], "requires": ["workspace_id"],
         "cases": [{"command": "terraform force-unlock {workspace_id}"}]}
      ]
    },
