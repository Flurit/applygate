{
  "comment": "AWS resource lists for the plan gate. Data, not code: add types here without changing the gate.",
  "stateful_types": [
    "aws_db_instance", "aws_rds_cluster", "aws_rds_cluster_instance", "aws_rds_global_cluster",
    "aws_docdb_cluster", "aws_neptune_cluster", "aws_dynamodb_table", "aws_dynamodb_global_table",
    "aws_s3_bucket", "aws_s3_directory_bucket", "aws_ebs_volume", "aws_ebs_snapshot",
    "aws_efs_file_system", "aws_fsx_lustre_file_system", "aws_fsx_windows_file_system",
    "aws_fsx_ontap_file_system", "aws_fsx_openzfs_file_system",
    "aws_elasticache_cluster", "aws_elasticache_replication_group", "aws_elasticache_serverless_cache",
    "aws_memorydb_cluster", "aws_opensearch_domain", "aws_elasticsearch_domain",
    "aws_redshift_cluster", "aws_redshiftserverless_namespace", "aws_kms_key", "aws_kms_replica_key",
    "aws_secretsmanager_secret", "aws_route53_zone", "aws_backup_vault", "aws_backup_plan",
    "aws_backup_vault_lock_configuration", "aws_glacier_vault", "aws_ecr_repository",
    "aws_kinesis_stream", "aws_msk_cluster", "aws_timestreamwrite_table", "aws_keyspaces_table",
    "aws_qldb_ledger", "aws_cognito_user_pool", "aws_db_snapshot", "aws_db_cluster_snapshot"
  ],
  "protection": [
    {"types": ["aws_db_instance", "aws_rds_cluster", "aws_docdb_cluster", "aws_neptune_cluster", "aws_rds_global_cluster"], "attr": "deletion_protection", "when": "change", "unsafe": false, "what": "deletion protection turned off"},
    {"types": ["aws_db_instance", "aws_rds_cluster", "aws_docdb_cluster", "aws_neptune_cluster", "aws_redshift_cluster"], "attr": "skip_final_snapshot", "when": "both", "unsafe": true, "what": "final snapshot skipped"},
    {"types": ["aws_db_instance", "aws_rds_cluster", "aws_docdb_cluster", "aws_neptune_cluster"], "attr": "backup_retention_period", "when": "change", "unsafe": 0, "what": "backup retention set to 0"},
    {"types": ["aws_db_instance"], "attr": "delete_automated_backups", "when": "delete", "unsafe": true, "what": "automated backups deleted with the instance"},
    {"types": ["aws_s3_bucket"], "attr": "force_destroy", "when": "both", "unsafe": true, "what": "forced bucket destroy enabled"},
    {"types": ["aws_dynamodb_table"], "attr": "deletion_protection_enabled", "when": "change", "unsafe": false, "what": "deletion protection turned off"},
    {"types": ["aws_dynamodb_table"], "attr": "point_in_time_recovery.0.enabled", "when": "change", "unsafe": false, "what": "point-in-time recovery turned off"},
    {"types": ["aws_s3_bucket_versioning"], "attr": "versioning_configuration.0.status", "when": "change", "unsafe": "Suspended", "what": "bucket versioning suspended"},
    {"types": ["aws_s3_bucket_versioning"], "attr": "versioning_configuration.0.status", "when": "change", "unsafe": "Disabled", "what": "bucket versioning disabled"},
    {"types": ["aws_kms_key"], "attr": "is_enabled", "when": "change", "unsafe": false, "what": "KMS key disabled"},
    {"types": ["aws_instance"], "attr": "disable_api_termination", "when": "change", "unsafe": false, "what": "termination protection turned off"},
    {"types": ["aws_lb", "aws_alb"], "attr": "enable_deletion_protection", "when": "change", "unsafe": false, "what": "load balancer deletion protection turned off"},
    {"types": ["aws_secretsmanager_secret"], "attr": "recovery_window_in_days", "when": "both", "unsafe": 0, "what": "secret deleted without a recovery window"},
    {"types": ["aws_elasticache_replication_group", "aws_elasticache_cluster"], "attr": "snapshot_retention_limit", "when": "change", "unsafe": 0, "what": "cache snapshot retention set to 0"}
  ],
  "admin_ports": [22, 3389, 3306, 5432, 1433, 1521, 6379, 11211, 27017, 9200, 9300, 5439, 2379, 5984, 8086, 9042],
  "admin_policies": ["AdministratorAccess", "IAMFullAccess", "PowerUserAccess", "AWSOrganizationsFullAccess"]
}
