{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadTheTerraformState",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::STATE_BUCKET", "arn:aws:s3:::STATE_BUCKET/*"]
    },
    {
      "Sid": "LetApplygateAuditThisRole",
      "Effect": "Allow",
      "Action": ["iam:SimulatePrincipalPolicy", "iam:GetRole"],
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/AgentReadOnly"
    }
  ]
}
