#!/bin/sh
# applygate-hook -- find or fetch the applygate binary for the Claude Code
# plugin, then run it.
#
#   sh applygate-hook hook claude   PreToolUse: run `applygate hook claude`
#   sh applygate-hook --fetch       SessionStart: make sure a binary is there
#
# The binary, first match wins:
#   1. $APPLYGATE_BIN
#   2. applygate on PATH (install.sh, Homebrew, go install)
#   3. the release pinned in pinned-release.txt, cached under
#      $CLAUDE_PLUGIN_DATA (kept across plugin updates; without it,
#      ${XDG_CACHE_HOME:-~/.cache}/applygate/plugin)
#   4. that release downloaded from GitHub, its sha256 checked against
#      pinned-release.txt, then cached as in 3
#
# The sha256 values come from the plugin itself, which is the reviewed source
# for this version, so a download is checked against a value that did not
# come from the same server.
#
# When no binary can be found, the hook mode exits 2 with the reason on
# stderr, which blocks the tool call (the hook also sets onFailure: block),
# and the fetch mode exits 1, which Claude Code shows as a hook error without
# stopping the session. Nothing is written to stdout except the binary's own
# output: the hook's stdout is its answer to Claude Code.
#
# APPLYGATE_PLUGIN_RELEASE_URL replaces the download base URL (for tests; the
# sha256 check still applies). POSIX sh, curl or wget.
set -eu

mode=hook
[ "${1:-}" = --fetch ] && mode=fetch

fail() {
    printf 'applygate plugin: %s\n' "$*" >&2
    printf 'applygate plugin: install applygate (https://github.com/Flurit/applygate#install) or set APPLYGATE_BIN to its path\n' >&2
    if [ "$mode" = hook ]; then exit 2; fi
    exit 1
}
need() { command -v "$1" >/dev/null 2>&1; }

# 1 and 2: a binary the user installed.
bin=""
if [ -n "${APPLYGATE_BIN:-}" ]; then
    [ -x "$APPLYGATE_BIN" ] || fail "APPLYGATE_BIN=$APPLYGATE_BIN is not an executable file"
    bin=$APPLYGATE_BIN
else
    bin=$(command -v applygate 2>/dev/null) || bin=""
fi
if [ -n "$bin" ]; then
    if [ "$mode" = fetch ]; then exit 0; fi
    exec "$bin" "$@"
fi

# 3: the pinned release, cached.
os=$(uname -s | tr '[:upper:]' '[:lower:]')
case "$os" in
    linux | darwin) ;;
    *) fail "no applygate on PATH, and releases are built for linux and darwin only (this is $os)" ;;
esac
arch=$(uname -m)
case "$arch" in
    x86_64 | amd64) arch=amd64 ;;
    aarch64 | arm64) arch=arm64 ;;
    *) fail "no applygate on PATH, and releases are built for amd64 and arm64 only (this is $arch)" ;;
esac

here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd) || fail "cannot locate the plugin directory"
pin="$here/pinned-release.txt"
[ -r "$pin" ] || fail "$pin is missing"
suffix="_${os}_${arch}.tar.gz"
line=$(awk -v s="$suffix" '$1 !~ /^#/ && length($2) > length(s) && substr($2, length($2) - length(s) + 1) == s { print $1, $2; exit }' "$pin")
sha=${line%% *}
archive=${line#* }
version=${archive#applygate_}
version=${version%"$suffix"}
case "$sha" in
    *[!0-9a-f]* | "") fail "pinned-release.txt has no valid sha256 for ${os}/${arch}" ;;
esac
[ ${#sha} -eq 64 ] || fail "pinned-release.txt has no valid sha256 for ${os}/${arch}"
case "$version" in
    *[!0-9A-Za-z.-]* | "") fail "pinned-release.txt names no valid release for ${os}/${arch}" ;;
esac

data=${CLAUDE_PLUGIN_DATA:-${XDG_CACHE_HOME:-$HOME/.cache}/applygate/plugin}
dest="$data/v$version/${os}_${arch}/applygate"
if [ -x "$dest" ]; then
    if [ "$mode" = fetch ]; then exit 0; fi
    exec "$dest" "$@"
fi

# 4: download, check, cache.
base=${APPLYGATE_PLUGIN_RELEASE_URL:-https://github.com/Flurit/applygate/releases/download}
url="$base/v$version/$archive"
# The hook has 30 s in all; SessionStart has longer.
if [ "$mode" = hook ]; then limit=20; else limit=100; fi

mkdir -p "$data" 2>/dev/null || fail "cannot create $data"
tmp=$(mktemp -d "$data/.fetch.XXXXXX") || fail "cannot create a temp dir in $data"
cleanup() { rm -rf "$tmp"; }
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if need curl; then
    curl -fsSL --retry 2 --max-time "$limit" -o "$tmp/$archive" "$url" 2>"$tmp/err" ||
        fail "no applygate on PATH, and downloading v$version failed: $url ($(head -n 1 "$tmp/err"))"
elif need wget; then
    wget -q -T "$limit" -O "$tmp/$archive" "$url" 2>"$tmp/err" ||
        fail "no applygate on PATH, and downloading v$version failed: $url"
else
    fail "no applygate on PATH, and neither curl nor wget is installed to download v$version"
fi

if need sha256sum; then
    actual=$(sha256sum "$tmp/$archive" | awk '{print $1}')
elif need shasum; then
    actual=$(shasum -a 256 "$tmp/$archive" | awk '{print $1}')
else
    fail "sha256sum or shasum is required to check the download"
fi
[ "$actual" = "$sha" ] || fail "sha256 mismatch for $archive (expected $sha, got $actual); not installing it"

tar -xzf "$tmp/$archive" -C "$tmp" applygate 2>/dev/null || fail "could not extract applygate from $archive"
chmod 755 "$tmp/applygate"
mkdir -p "$(dirname -- "$dest")" || fail "cannot create $(dirname -- "$dest")"
# A rename within one file system, so a concurrent session never runs a
# half-written binary.
mv -f "$tmp/applygate" "$dest" || fail "cannot install into $dest"
printf 'applygate plugin: installed applygate v%s to %s\n' "$version" "$dest" >&2

cleanup
trap - EXIT
if [ "$mode" = fetch ]; then exit 0; fi
exec "$dest" "$@"
